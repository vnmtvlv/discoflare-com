NUXT_CLOUDFLARE_OAUTH_CLIENT_ID=
NUXT_CLOUDFLARE_OAUTH_CLIENT_SECRET=
NUXT_CLOUDFLARE_OAUTH_SCOPES="d1.read d1.write containers.read containers.write workers-kv-storage.read workers-kv-storage.write workers-r2.read workers-r2.write workers-scripts.read workers-scripts.write account-settings.read memberships.read"
NUXT_INSTALLER_SESSION_PASSWORD=replace-with-a-random-32-character-or-longer-secret
NUXT_INSTALLER_ORIGIN=https://discoflare.com
NUXT_INSTALLER_MANIFEST_URL=https://github.com/vnmtvlv/discoflare/releases/latest/download/discoflare-cloudflare-manifest.json
