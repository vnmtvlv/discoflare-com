{
  "name": "discoflare-com",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nuxt build",
    "deploy": "pnpm build && pnpm db:migrate && pnpm dlx wrangler@4.128.0 deploy",
    "db:create": "pnpm dlx wrangler@4.128.0 d1 create discoflare-com-telemetry",
    "db:migrate": "pnpm dlx wrangler@4.128.0 d1 migrations apply TELEMETRY_DB --remote",
    "dev": "nuxt dev",
    "generate": "nuxt generate --preset=static",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.97",
    "@iconify-json/ph": "^1.2.2",
    "@nuxt/content": "^3.16.0",
    "@nuxt/ui": "^4.11.0",
    "cloudflare": "7.1.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "better-sqlite3": "^13.0.3",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
